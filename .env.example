# Local and deployment configuration. Copy to .env and fill in. NEVER commit .env (it is git-ignored).
# infra/deploy_hub.ps1 writes the first three lines for you when it deploys the hub.

# The deployed hub (written by infra/deploy_hub.ps1)
HUB_URL=https://<your-hub>.<region>.azurecontainerapps.io
HUB_API_KEY=<generated by deploy_hub.ps1; a secret>
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-account>.services.ai.azure.com/api/projects/<project>

# Optional overrides for the agent deployment (agents/definitions.py). These are read from the SHELL ENVIRONMENT when you run
# `python -m agents.deploy_agents` (for example `$env:REPORT_MODEL = "my-deployment"` in PowerShell), not from this file.
# NAME_PREFIX=croma                   agents are <prefix>-cx, <prefix>-data ...; connections are <prefix>-hub-*; set the SAME value on the hub, the
#                                     agent deployment and the chat UI. A different prefix gives a second copy of the system next to the first.
# AGENT_MODEL=gpt-5.4-mini            conversational agents (CX, Lookup, Research, Analysis, Data)
# AGENT_REASONING_EFFORT=low
# REPORT_MODEL=gpt-6-sol              the report team (a deep-reasoning deployment in your Foundry project)
# REPORT_EFFORT_INSIGHT=high          per role: REPORT_EFFORT_<ROLE> = low | medium | high
# MEMORY_STORE=croma-user-memory      default <NAME_PREFIX>-user-memory
# MEMORY_SCOPE=croma-user-1           default <NAME_PREFIX>-user-1; one value per user when several people share the store
# MEMORY_TOOL_SCOPE={{$userId}}       the scope the CX agent's memory search is deployed with (default: MEMORY_SCOPE). "{{$userId}}" gives every signed-in user
#                                     their own memory when the chat API runs behind the API gateway (docs/APIM.md)

# Chat API settings (ui/backend/main.py). Locally the UI reads HUB_URL, HUB_API_KEY and FOUNDRY_PROJECT_ENDPOINT from this file; in a container (ui/Dockerfile)
# they, and the settings below, arrive as environment variables (infra/apim/deploy_apim.ps1 sets them).
# CX_AGENT=croma-cx                   the agent the chat talks to (default <NAME_PREFIX>-cx)
# GATEWAY_KEY=<a secret>              set it when the chat API sits behind Azure API Management: the API then believes x-user-id only on a request that carries
#                                     this value in x-gateway-key, and keeps conversations and memory per user. Not set: single-user, exactly as without a gateway
# SSE_HEARTBEAT_S=15                  send an invisible keep-alive line on the streaming chat response every so many seconds (default 0 = none); needed behind
#                                     a gateway, because idle connections are cut after about four minutes
# SHARE_HUB_EVENTS=1                  behind the gateway, also show the hub's live event log (it is not per user, so off by default)
# ENABLE_STREAM_CHECK=1               serve GET /api/stream-check, a synthetic event stream for testing a gateway (off by default)
# CHAT_DB_PATH=/data/chat.db          where the conversation history (SQLite) is kept (default ui/backend/data/chat.db)

# Hub settings (set on the hub container app by infra/deploy_hub.ps1 from infra/config.ps1; listed here for local runs of hub/app.py)
# GENIE_BACKEND=stub                  stub | databricks | custom
# DATABRICKS_HOST=https://adb-<workspace-id>.<n>.azuredatabricks.net
# GENIE_SPACE_ID=<genie space id>
# DATABRICKS_AUTH=managed_identity    managed_identity | token | apim
# DATABRICKS_TOKEN=<personal access token>    only for DATABRICKS_AUTH=token, quick tests only
# APIM_SUBSCRIPTION_KEY=<key>         only for DATABRICKS_AUTH=apim: the data gateway's subscription key (DATABRICKS_HOST is then the gateway's URL)
# CUSTOM_BACKEND=my_backend:ask
# GENIE_TOOL_DESCRIPTION=<what the connected data covers>
# GENIE_MAX_ROWS=200
# DATA_PARALLELISM=4                  how many data questions may run at once
# AGENT_CALL_TIMEOUT_S=3600
