<!--
  Operation policy for POST /api/chat: one call starts one agent turn (a model run that can take minutes), so it gets its own, stricter limit on top of
  the API-wide one, and an optional daily quota per user. Everything else is inherited from the API policy (authentication, headers, streaming).
-->
<policies>
  <inbound>
    <base />
    <rate-limit-by-key calls="__CHAT_CALLS__" renewal-period="60" counter-key="@("chat:" + (string)context.Variables["user-id"])" remaining-calls-header-name="x-chat-ratelimit-remaining" />
    __CHAT_QUOTA__
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
